{
  "manifest_version": 3,
  "name": "Pemantau FB Marketplace",
  "version": "1.0.0",
  "description": "Menyedot harga HP dari Facebook Marketplace langsung ke aplikasi Pemantau HP.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.facebook.com/marketplace/*",
    "https://*.vercel.app/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/marketplace/*"],
      "js": ["auto_scrape.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
